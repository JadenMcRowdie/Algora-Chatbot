    {
      "id": "68aea8e4f3c7240008229a58",
      "name": "Give industry-specific AI applications",
      "createdByID": 1762161,
      "folderID": null,
      "settings": {
        "model": "claude-4-sonnet",
        "maxTokens": 500,
        "temperature": 0.3
      },
      "description": null,
      "instructions": [
        {
          "text": [
            "Provide clear and practical examples of how AI is used in the chosen industry. Use almost lay-friendly language, reference real projects if possible, and offer simple diagrams/illustrations (describe if not available). Cross-link related applications or concepts. Encourage follow-up questions (up to 3). Cite relevant bootcamp modules. Also add a diagram related to the topic."
          ]
        }
      ],
      "pathToolOrder": [
