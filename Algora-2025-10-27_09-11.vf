    {
      "id": "68aea8e4f3c7240008229a54",
      "name": "Explain AI core terminology",
      "createdByID": 1762161,
      "folderID": null,
      "settings": {
        "model": "claude-4-sonnet",
        "maxTokens": 500,
        "temperature": 0.3
      },
      "description": null,
      "instructions": [
        {
          "text": [
            "Answer the user with detailed, jargon-free explanations of core AI concepts such as: Machine Learning, NLP, Large Language Models, Neural Networks, Computer Vision, and explain distinctions between AI, ML, and Deep Learning. Present relevant diagrams or simple visualizations as available (e.g., a chart contrasting AI, ML, Deep Learning). Provide citations to specific bootcamp course materials for further reading. Encourage follow-up questions or exploration of related concepts."
          ]
        }
      ],
      "pathToolOrder": [
