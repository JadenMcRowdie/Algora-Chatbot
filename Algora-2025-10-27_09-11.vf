    {
      "id": "68aea8e4f3c7240008229a55",
      "name": "Handle follow-up on terminology",
      "createdByID": 1762161,
      "folderID": null,
      "settings": {
        "model": "claude-4-sonnet",
        "maxTokens": 500,
        "temperature": 0.3
      },
      "description": null,
      "instructions": [
        {
          "text": [
